# Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit ".env" -- it is listed in .gitignore.

# Server-only key with "Routes API" enabled (leave blank to use offline routes).
# Never put this key in frontend code or reuse it as the browser key.
GOOGLE_MAPS_API_KEY=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto  = use Google Routes when a key exists, else offline fallback
# offline = never call Google (predefined / straight-line routes only)
ROUTE_MODE=auto

# Separate browser key for the map (Maps JavaScript API + Places API).
# Required for Google maps. It never falls back to GOOGLE_MAPS_API_KEY.
# Restrict it in Google Cloud to the websites that serve the map:
#   http://localhost:5173/*   embedded dashboard map through Vite
#   http://localhost:8000/*   full viewer opened directly
# If Vite uses another port or host, add that exact origin too.
GOOGLE_MAPS_BROWSER_KEY=
# The live map's From/To boxes search with Google Places API (New) when it is enabled for
# GOOGLE_MAPS_API_KEY; otherwise with OpenStreetMap (Photon). Set to off to use Google only.
PLACE_SEARCH_FALLBACK=on

# --- Google sign-in (send Gmail, read Calendar) ---
# Enable only the Gmail API and Google Calendar API for this sign-in.
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web) -> Download JSON.
# Put it in backend/secrets/ (git-ignored). Path is relative to the backend folder.
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
# Optional: where to send the browser after connecting (e.g. your frontend's setup page).
# For the dashboard rehearsal use http://localhost:5173/
GOOGLE_OAUTH_DONE_URL=
# Encrypts the stored Google token. Generate: python -m app.google_auth --new-key
# Changing it later means reconnecting Google.
TOKEN_ENCRYPTION_KEY=

# --- Supabase (server-side only; never put the secret key in frontend code) ---
# Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Approved Google rehearsal ---
# Only this Google account may connect. It sends the email and owns the test calendar.
GOOGLE_ALLOWED_ACCOUNT_EMAIL=
# The one caregiver test address. That person must agree to receive test emails.
HELP_EMAIL_TO=
# Change to yes only after that person has agreed.
HELP_EMAIL_CONSENT=no
# Calendar to read: "primary" or a dedicated test calendar ID.
GOOGLE_CALENDAR_ID=

# --- Email escalation (sent from the connected Gmail) ---
# Base URL for the "I'm on it" links inside alert emails.
PUBLIC_BASE_URL=http://localhost:8000
# Seconds a medium check-in can go unanswered before contact #1 is emailed.
CHECKIN_REPLY_TIMEOUT_S=180
# Seconds to wait for "I'm on it" before emailing the next contact.
ESCALATION_STEP_S=300
# How often the background timer checks (seconds).
ESCALATION_TICK_S=15

# --- Visit reminders (Google Calendar) ---
# A timed event with a trusted contact as a guest is a visit. Show it this many minutes before...
VISIT_REMINDER_LEAD_MIN=20
# ...until this many minutes after it starts.
VISIT_REMINDER_GRACE_MIN=30
# Email the connected account about every timed calendar event, VISIT_REMINDER_LEAD_MIN before it.
# This is on by default. Set it to off before a live restart unless that account should get these emails.
CALENDAR_EMAILS=on
