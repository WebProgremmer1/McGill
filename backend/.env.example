# Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit ".env" -- it is listed in .gitignore.

# Google Cloud API key with "Routes API" enabled (leave blank to use offline mock routes)
GOOGLE_MAPS_API_KEY=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto  = use Google Routes when a key exists, else offline fallback
# offline = never call Google (predefined / straight-line routes only)
ROUTE_MODE=auto

# Key the live map page loads in the browser (Maps JavaScript API + Places API).
# Leave blank to reuse GOOGLE_MAPS_API_KEY. Restrict it to http://localhost:8000/* in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=

# --- Google sign-in (Gmail / Calendar / Contacts) ---
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web) -> Download JSON.
# Put it in backend/secrets/ (git-ignored). Path is relative to the backend folder.
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
# Optional: where to send the browser after connecting (e.g. your frontend's setup page).
GOOGLE_OAUTH_DONE_URL=
# Encrypts the stored Google token. Generate: python -m app.google_auth --new-key
# Changing it later means reconnecting Google.
TOKEN_ENCRYPTION_KEY=

# --- Supabase (server-side only; never put the secret key in frontend code) ---
# Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
